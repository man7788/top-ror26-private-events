<h1>User <%= params[:id] %></h1>

<%= render "shared/nav", user: @user %>

<% if @user %>
  <%= link_to "New Event", new_event_path %>
<% end %>

<h2>Created Events:</h2>
<ul>
  <% @events.each do |e| %>
    <li>
      <h3><%=e.name %></h3>
      <%= e.event_date %>
    </li>
  <% end %>
</ul>

<h2>Registered Events:</h2>
<h3>Future Events:</h3>
<ul>
  <% @attended_events.each do |e| %>
    <% if e.event_date > Time.now %>
      <li>
        <h3><%=e.name %></h3>
        <%=e.event_date %>
      </li>
    <% end %>
  <% end %>
</ul>

<h3>Past Events:</h3>
<ul>
  <% @attended_events.each do |e| %>
    <% if e.event_date < Time.now %>
      <li>
        <h3><%=e.name %></h3>
        <%=e.event_date %>
      </li>
    <% end %>
  <% end %>
</ul>
