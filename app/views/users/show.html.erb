<h1>User <%= params[:id] %></h1>

<%= render "shared/nav", user: @user %>

<% if @user %>
  <%= link_to "New Event", new_event_path %>
<% end %>

<h2>Created Events:</h2>
<ul>
  <% @events.each do |e| %>
      <li>
        <article>
          <h3><%=e.name %></h3>
          <%= e.event_date %>
        </article>
      </li>
  <% end %>
  </ul>

<h2>Registered Events:</h2>
<ul>
  <% @attended_events.each do |e| %>
    <li>
      <article>
        <h3><%=e.name %></h3>
        <%= e.event_date %>
      </article>
    </li>
  <% end %>
</ul>
