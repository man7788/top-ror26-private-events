<h1>User <%= params[:id] %></h1>

<%= render "shared/nav", user: @user %>

<% if @user %>
  <%= link_to "New Event", new_event_path %>
<% end %>

<% if @events %>
  <ul>
    <% @events.each do |e| %>
        <li>
          <article>
            <h2><%=e.name %></h2>
            <%= e.event_date %>
          </article>
        </li>
  <% end %>
   </ul>
<% end %>
