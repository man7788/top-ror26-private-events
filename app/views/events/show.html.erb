<h1><%= @event.name %></h1>

<%= render "shared/nav", user: @user %>

<ul>
  <li>Date: <%= @event.event_date %></li>
  <li>Created By: <%= @event.creator.email %></li>
</ul>

<b><%= flash[:alert] %></b>
<% if @creator %>
  <%= form_with model: @event_attendance do |form| %>
    <%= form.hidden_field :event_id, value: @event.id %>
    <%= form.label :user_email, 'Invite a user to this event:' %><br>
    <%= form.email_field :user_email %><br>
    <%= form.submit "Submit" %>
  <% end %>
<% end %>

<h2>People who are attending this event:</h2>
<ul>
  <% @attendees.each do |a| %>
    <li>
      <%= a %>
    </li>
  <% end %>
</ul>

<% if @attended %>
  <p>You are registered for this event.</p>
<% end %>
