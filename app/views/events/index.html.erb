<h1>Events</h1>

<%= render "shared/nav", user: @user %>

<% if flash[:alert] %>
    <h2><%= flash[:alert] %></h2>
<% else %>
  <% if @user %>
    <h2>Welcome back <%= @user.email %>!</h2>
  <% end %>

  <h3>Future Events:</h3>
  <ul>
    <% Event.future_events.each do |e| %>
      <li>
        <%= link_to e.name, event_path(e.id) %>
      </li>
    <% end %>
  </ul>

  <h3>Past Events:</h3>
  <ul>
    <% Event.past_events.each do |e| %>
      <li>
        <%= link_to e.name, event_path(e.id) %>
      </li>
    <% end %>
  </ul>

  <% if @user %>
    <nav>
      <%= button_to "Log out", destroy_user_session_path, method: :delete %>
    </nav>
  <% else %>
    <nav>
      <%= button_to "Sign in", new_user_session_path%>
      <%= link_to "Sign up", new_user_registration_path%>
    </nav>
  <% end %>
<% end %>
